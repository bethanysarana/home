---
import Base from '../../layouts/Base.astro';
import { SECTIONS, published, url, slugify } from '../../site';

// One page per theme tag, gathering everything tagged with it across all sections.
export async function getStaticPaths() {
  const byTheme = new Map<string, { name: string; items: { label: string; title: string; href: string }[] }>();
  for (const s of SECTIONS) {
    for (const entry of await published(s.collection)) {
      for (const t of entry.data.themes) {
        const key = slugify(t);
        if (!byTheme.has(key)) byTheme.set(key, { name: t, items: [] });
        byTheme.get(key)!.items.push({ label: s.label, title: entry.data.title, href: url(`${s.path}/${entry.id}/`) });
      }
    }
  }
  return [...byTheme].map(([theme, data]) => ({ params: { theme }, props: data }));
}

const { name, items } = Astro.props;
---
<Base title={`Theme: ${name}`}>
  <div class="wrap">
    <p class="eyebrow">Theme</p>
    <h1>{name}</h1>
    <ul class="item-list">
      {items.map((i) => <li><a href={i.href}><span class="eyebrow">{i.label}</span><span class="item-title">{i.title}</span></a></li>)}
    </ul>
  </div>
</Base>
