---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SECTIONS, SITE_TITLE, AUTHOR, published, url, fmtDate, slugify } from '../../site';

export async function getStaticPaths() {
  const paths = [];
  for (const section of SECTIONS) {
    for (const entry of await published(section.collection)) {
      paths.push({ params: { section: section.path, slug: entry.id }, props: { section, entry } });
    }
  }
  return paths;
}

const { section, entry } = Astro.props as any;
const d = entry.data;
const { Content } = await render(entry);

// "Continue the conversation": anything elsewhere on the site sharing a theme.
const related: { label: string; title: string; href: string }[] = [];
if (d.themes.length) {
  for (const s of SECTIONS) {
    for (const other of await published(s.collection)) {
      if (s.collection === section.collection && other.id === entry.id) continue;
      if (other.data.themes.some((t: string) => d.themes.includes(t))) {
        related.push({ label: s.label, title: other.data.title, href: url(`${s.path}/${other.id}/`) });
      }
    }
  }
}

const permalink = new URL(url(`${section.path}/${entry.id}/`), Astro.site).href;
const year = d.publishedDate.getFullYear();
---
<Base title={d.title} description={d.summary}>
  <article class="wrap">
    {section.collection === 'conversations'
      ? <p class="eyebrow">Conversation {String(d.number).padStart(2, '0')} · {d.place}</p>
      : <p class="eyebrow"><a href={url(`${section.path}/`)}>{section.label}</a>{d.shortTitle && ` · ${d.shortTitle}`}</p>}
    <h1>{d.title}</h1>
    <p class="meta">
      Published {fmtDate(d.publishedDate)}{d.updatedDate && ` · Updated ${fmtDate(d.updatedDate)}`}
    </p>

    {section.collection === 'art' && <figure><img src={d.image} alt={d.alt} style="width:100%;height:auto" /></figure>}

    <div class="prose"><Content /></div>

    {d.evidence && <p class="evidence">{d.evidence}</p>}

    {d.alsoPublished?.length > 0 && (
      <p class="meta">Also published in: {d.alsoPublished.map((p: any, i: number) => <>{i > 0 && ', '}<a href={p.url}>{p.name}</a></>)}</p>
    )}

    {d.themes.length > 0 && (
      <ul class="tags">
        {d.themes.map((t: string) => <li><a href={url(`themes/${slugify(t)}/`)}>{t}</a></li>)}
      </ul>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>Continue the conversation</h2>
        <ul class="item-list">
          {related.map((r) => <li><a href={r.href}><span class="eyebrow">{r.label}</span><span class="item-title">{r.title}</span></a></li>)}
        </ul>
      </section>
    )}

    <p class="cite">
      <strong>Cite this page:</strong> {AUTHOR} ({year}) ‘{d.title}’, <em>{SITE_TITLE}</em>. Available at: {permalink}
    </p>
  </article>
</Base>
