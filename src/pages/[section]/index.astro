---
import Base from '../../layouts/Base.astro';
import { SECTIONS, liveSections, published, url, fmtDate } from '../../site';

// Only sections with published content get an index page.
export async function getStaticPaths() {
  const live = await liveSections();
  return live.map((s) => ({ params: { section: s.path }, props: { section: s } }));
}

const { section } = Astro.props as { section: (typeof SECTIONS)[number] };
const items = await published(section.collection);
---
<Base title={section.label}>
  <div class="wrap">
    <h1>{section.label}</h1>
    <ul class="item-list">
      {items.map((item) => {
        const d = item.data as Record<string, any>;
        return (
          <li>
            <a href={url(`${section.path}/${item.id}/`)}>
              {section.collection === 'conversations' && <span class="eyebrow">Conversation {String(d.number).padStart(2, '0')} · {d.place}</span>}
              {d.shortTitle && <span class="eyebrow">{d.shortTitle}</span>}
              <span class="item-title">{d.title}</span>
            </a>
            {d.evidence && <p class="meta">{d.evidence}</p>}
            {section.collection === 'dispatches' && <p class="meta">{fmtDate(d.publishedDate)}</p>}
          </li>
        );
      })}
    </ul>
  </div>
</Base>
