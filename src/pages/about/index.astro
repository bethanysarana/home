---
// About (specification §10). Text from src/data/about.json, generated by
// scripts/make_fieldnotes.py from the WordPress page and Report 4, unchanged.
// The facts list and the two strand titles are the specification's own wording.
import BaseLayout from '../../layouts/BaseLayout.astro';
import A from '../../data/about.json';
import { SITE } from '../../data/site';
import { href } from '../../data/navigation';
const FACTS = [
  'Doctor of Applied Health Research', 'Trained data scientist', 'UCL PhD completed in 2024',
  'Independent project without university host or grant dependency',
];
---
<BaseLayout title="About" description="Bethany Wickramasinghe and the two strands of the Let's Talk About “Home” project.">
  <header class="intro container container--wide grid-12">
    <div class="head">
      <h1>About</h1>
      <p class="name hand">{SITE.author}</p>
    </div>
    <figure class="portrait">
      <img src={href(SITE.heroImage)} alt="A thatched wooden shelter looking out over bamboo huts and A-frame cabins, with a pot of tea on the table" width="1600" height="900" loading="eager" />
    </figure>
  </header>

  <section class="container container--wide grid-12 bg" aria-labelledby="bg-h">
    <div class="side"><h2 id="bg-h">Background</h2></div>
    <div class="main">
      <p class="lead">{A.wpIntro}</p>
      <p class="question">{A.wpQuestion}</p>
      <p>{A.reportIntro}</p>
      <ul class="facts">{FACTS.map((f) => <li>{f}</li>)}</ul>
    </div>
  </section>

  <section class="container container--wide grid-12 bg" aria-labelledby="origin-h">
    <div class="side"><h2 id="origin-h">Where it began</h2></div>
    <div class="main">
      <p>{A.origin}</p>
      <p>{A.impact}</p>
    </div>
  </section>

  <section class="strands surface-paper" aria-labelledby="strands-h">
    <div class="container container--wide">
      <h2 id="strands-h">Two strands</h2>
      <div class="pair">
        <article class="strand">
          <span class="n">01</span>
          <h3>Qualitative research into home, belonging, identity and movement.</h3>
          <ul class="go">
            <li><a class="arrow-link" href={href('stories/')}>The Stories <span aria-hidden="true">→</span></a></li>
            <li><a class="arrow-link" href={href('what-emerges/')}>What Emerges <span aria-hidden="true">→</span></a></li>
            <li><a class="arrow-link" href={href('research/')}>The Research <span aria-hidden="true">→</span></a></li>
          </ul>
        </article>
        <article class="strand personal">
          <span class="n">02</span>
          <h3>A personal experiment in reconciling scientist, storyteller and artist while living a nomadic life.</h3>
          <p>{A.wpFollow}</p>
          <ul class="go">
            <li><a class="arrow-link" href={href('fieldnotes/')}>Fieldnotes <span aria-hidden="true">→</span></a></li>
            <li><a class="arrow-link" href={href('visual-archive/')}>Visual Archive <span aria-hidden="true">→</span></a></li>
          </ul>
        </article>
      </div>
      <p class="registers">{A.registers}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: var(--space-9) var(--space-7); align-items: end; }
  .head { grid-column: 1 / span 7; }
  .head h1 { margin: 0; }
  .name { margin: var(--space-3) 0 0; font-size: 2rem; color: var(--purple); }
  .portrait { grid-column: 9 / -1; margin: 0; }
  .portrait img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-medium); }
  .bg { padding-block: var(--space-7); border-top: 1px solid var(--rule); }
  .side { grid-column: 1 / span 4; }
  .side h2 { margin: 0; font-size: var(--text-h3); }
  .main { grid-column: 6 / -1; max-width: 42rem; }
  .main p { margin: 0 0 var(--space-5); }
  .question { font-family: var(--font-display); font-style: italic; font-size: var(--text-h3); color: var(--purple); }
  .facts { list-style: none; margin: var(--space-6) 0 0; padding: var(--space-5) 0 0; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .facts li { padding: 0.25rem 0.75rem; border: 1px solid var(--rule-strong); border-radius: 999px; font-size: var(--text-small); }
  .strands { padding-block: var(--space-9); border-top: 1px solid var(--rule); }
  .strands h2 { margin: 0 0 var(--space-6); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--grid-gap); }
  .strand { display: flex; flex-direction: column; padding: var(--space-6); background: var(--white); border: 1px solid var(--rule); border-radius: var(--radius-medium); }
  .strand.personal { background: var(--pink); border-color: transparent; }
  .strand .n { font-family: var(--font-display); font-size: 3rem; line-height: 1; color: var(--purple); }
  .strand h3 { margin: var(--space-4) 0; font-size: var(--text-h3); line-height: 1.25; }
  .strand p { margin: 0 0 var(--space-5); }
  .go { list-style: none; margin: auto 0 0; padding: var(--space-4) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .registers { margin: var(--space-7) 0 0; max-width: 46rem; font-family: var(--font-display); font-size: var(--text-lead); line-height: 1.55; }
  @media (max-width: 1023px) {
    .head, .portrait, .side, .main { grid-column: 1 / -1; }
    .portrait { margin-top: var(--space-6); max-width: 24rem; }
    .side { margin-bottom: var(--space-4); }
  }
  @media (max-width: 767px) { .pair { grid-template-columns: 1fr; } }
</style>
