---
// What Emerges (specification §7): the ideas connecting the stories.
// All research text comes from Report 2 via scripts/make_ideas.py, unchanged:
// opening = §4.1 Summary, each idea = §3 heading + §4 Discussion paragraphs,
// closing = §4.8 Conclusion. Labels added by Claude are listed in MIGRATION_NOTES.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { archiveParticipants } from '../../data/participants';
import { STORY_PARTICIPANTS } from '../../data/relationships';
import { toneFor } from '../../data/story-tones';
import { href } from '../../data/navigation';
import frame from '../../data/what-emerges-frame.json';

const ideas = (await getCollection('ideas')).sort((a, b) => a.data.order - b.data.order);
const stories = await getCollection('stories');
const everyone = archiveParticipants();
const byId = Object.fromEntries(ideas.map((i) => [i.id, i]));

const entries = await Promise.all(ideas.map(async (idea) => {
  const { Content } = await render(idea);
  const linked = idea.data.stories.map((slug) => {
    const s = stories.find((x) => x.id === slug);
    if (!s) throw new Error(`What Emerges: unknown story "${slug}" in ${idea.id}`);
    return s;
  });
  // People named in the discussion first, then the people behind the linked stories.
  const ids = [...idea.data.people, ...idea.data.stories.flatMap((slug) => (STORY_PARTICIPANTS[slug] ?? []).map((l) => l.participant))];
  const people = [...new Set(ids)].map((id) => {
    const p = everyone.find((x) => x.id === id);
    if (!p) throw new Error(`What Emerges: unknown participant "${id}" in ${idea.id}`);
    return p;
  });
  const related = idea.data.related.map((slug) => {
    if (!byId[slug]) throw new Error(`What Emerges: unknown related idea "${slug}" in ${idea.id}`);
    return byId[slug];
  });
  return { idea, Content, empty: !idea.body?.trim(), linked, people, related };
}));
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout title="What Emerges" description="The ideas connecting the stories from 26 conversations about home.">
  <header class="intro container container--wide grid-12">
    <div class="head">
      <p class="eyebrow">What Emerges · Report 2, section 4.1</p>
      <h1>What Emerges</h1>
    </div>
    <div class="text">
      {frame.summary.map((p) => <p>{p}</p>)}
    </div>
  </header>

  <nav class="index container container--wide" aria-label="The seven ideas">
    <ol>
      {ideas.map((i) => (
        <li><a href={`#${i.id}`}><span class="n">{pad(i.data.order)}</span><span>{i.data.title}</span></a></li>
      ))}
    </ol>
  </nav>

  {entries.map(({ idea, Content, empty, linked, people, related }) => (
    <section class="idea" id={idea.id} aria-labelledby={`h-${idea.id}`}>
      <div class="container container--wide grid-12">
        <div class="side">
          <span class="n" aria-hidden="true">{pad(idea.data.order)}</span>
          <h2 id={`h-${idea.id}`}>{idea.data.title}</h2>
        </div>
        <div class="main">
          <p class="caption">Report 2, section {idea.data.introSection}</p>
          <p class="finding">{idea.data.intro}</p>

          {empty ? (
            <aside class="placeholder" aria-label="Placeholder">
              <span class="eyebrow">Discussion to come</span>
              <p>Placeholder: Report 2's discussion (section 4) has no paragraph on this idea yet.</p>
            </aside>
          ) : (
            <div class="prose">
              <p class="caption">Report 2, section {idea.data.discussionSections.join(' and ')}</p>
              <Content />
            </div>
          )}

          <div class="links">
            <div>
              <h3 class="eyebrow">{linked.length > 1 ? 'Stories' : 'Story'}</h3>
              <ul class="stories">
                {linked.map((s) => (
                  <li class={`tone-${toneFor(s.data.order)}`}>
                    <a href={href(`stories/${s.id}/`)}>{s.data.label} <span aria-hidden="true">→</span></a>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="eyebrow">People</h3>
              <ul class="people">
                {people.map((p) => <li><a class="hand" href={href(`visual-archive/#p-${p.id}`)}>{p.displayName}</a></li>)}
              </ul>
            </div>
            <div>
              <h3 class="eyebrow">Related ideas</h3>
              <ul class="related">
                {related.map((r) => <li><a class="arrow-link" href={`#${r.id}`}>{r.data.title} <span aria-hidden="true">→</span></a></li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="closing surface-purple" aria-labelledby="conclusion">
    <div class="container container--wide grid-12">
      <div class="side">
        <p class="eyebrow">Report 2, section 4.8</p>
        <h2 id="conclusion">Conclusion</h2>
      </div>
      <div class="main">
        {frame.conclusion.map((p) => <p>{p}</p>)}
        <p class="next">
          <a class="button" href={href('stories/')}>The Stories</a>
          <a class="button button--outline" href={href('visual-archive/')}>Visual Archive</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: var(--space-9) var(--space-7); align-items: start; }
  .head { grid-column: 1 / span 5; }
  .head h1 { margin: 0; }
  .text { grid-column: 7 / -1; }
  .text p { margin: 0; font-size: var(--text-lead); line-height: 1.55; }

  .index { padding-bottom: var(--space-8); }
  .index ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); border-top: 1px solid var(--rule); }
  .index li { border-bottom: 1px solid var(--rule); }
  .index a { display: flex; gap: var(--space-3); align-items: baseline; padding: var(--space-4) var(--space-3) var(--space-4) 0; color: var(--ink); text-decoration: none; font-family: var(--font-display); font-size: var(--text-lead); line-height: 1.25; }
  .index a:hover span:last-child { text-decoration: underline; }
  .index .n { font-size: var(--text-small); font-family: var(--font-body); color: var(--purple); font-variant-numeric: tabular-nums; }

  .idea { padding-block: var(--space-9); border-top: 1px solid var(--rule); scroll-margin-top: 4rem; }
  .idea:nth-of-type(even) { background: var(--white); }
  .side { grid-column: 1 / span 4; align-self: start; position: sticky; top: 6rem; }
  .side .n { display: block; font-family: var(--font-display); font-size: clamp(3rem, 6vw, 5rem); line-height: 1; color: var(--purple); }
  .side h2 { margin: var(--space-3) 0 0; font-size: var(--text-h2); }
  .main { grid-column: 6 / -1; max-width: 42rem; }
  .caption { margin: 0 0 var(--space-2); color: var(--text-muted); }
  .finding { margin: 0 0 var(--space-7); font-family: var(--font-display); font-style: italic; font-size: var(--text-h3); line-height: 1.3; }
  .prose :global(p) { margin: 0 0 var(--space-5); }
  .placeholder { margin-bottom: var(--space-7); padding: var(--space-5) var(--space-6); border: 1.5px dashed var(--rule-strong); border-radius: var(--radius-medium); color: var(--text-muted); }
  .placeholder p { margin: var(--space-2) 0 0; font-size: var(--text-small); }

  .links { display: grid; gap: var(--space-5); margin-top: var(--space-7); padding-top: var(--space-6); border-top: 1px solid var(--rule); }
  .links h3 { margin: 0 0 var(--space-3); }
  .links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
  .stories a { display: inline-block; padding: var(--space-2) var(--space-4); border-radius: var(--radius-small); color: var(--ink); text-decoration: none; font-family: var(--font-display); font-size: var(--text-lead); }
  .stories a:hover { text-decoration: underline; }
  .tone-purple a { background: var(--purple-deep); color: var(--white); }
  .tone-pink a { background: var(--pink); }
  .tone-yellow a { background: var(--yellow); }
  .tone-paper a { background: var(--paper); border: 1px solid var(--rule-strong); }
  .people a { display: inline-block; padding: 0.1rem 0.6rem; border: 1px solid var(--rule-strong); border-radius: 999px; color: var(--ink); text-decoration: none; font-size: 1.35rem; background: var(--white); }
  .people a:hover { border-color: var(--purple); color: var(--purple); }
  .related { flex-direction: column; }

  .closing { padding-block: var(--space-9); }
  .closing .side { position: static; }
  .closing .eyebrow { color: var(--yellow); }
  .closing .main p { font-size: var(--text-lead); line-height: 1.55; }
  .closing .next { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  @media (max-width: 1023px) {
    .head, .text, .side, .main { grid-column: 1 / -1; }
    .text { margin-top: var(--space-5); }
    .side { position: static; margin-bottom: var(--space-5); }
    .idea { padding-block: var(--space-8); }
  }
</style>
