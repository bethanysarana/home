---
// The Stories overview: all eight findings as editorial blocks.
// Text is from the WordPress "Headline findings" section.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryGrid from '../../components/stories/StoryGrid.astro';
import { TOTAL_PARTICIPANTS } from '../../data/participants';

const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="The Stories" description="Eight traveller stories drawn from thematic analysis of 26 conversations about home.">
  <header class="intro container container--wide grid-12">
    <div class="head">
      <p class="eyebrow">The Stories · {TOTAL_PARTICIPANTS} conversations</p>
      <h1>Headline findings: <em>Travellers</em></h1>
    </div>
    <div class="text">
      <p class="lead">Eight traveller "stories" stand out. Each story is drawn from thematic analysis across every conversation to date.</p>
      <p>Click through to see what's actually behind each one.</p>
    </div>
  </header>

  <section class="container container--wide list" aria-label="The eight stories">
    <StoryGrid stories={stories} />
    <p class="footer-note">This full analysis draws from every conversation collected with travellers across the project.</p>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: var(--space-9) var(--space-7); align-items: end; }
  .head { grid-column: 1 / span 7; }
  .head h1 { margin: 0; }
  .head h1 em { color: var(--purple); }
  .text { grid-column: 9 / -1; }
  .text p:last-child { margin: 0; color: var(--text-muted); }
  .list { padding-bottom: var(--space-9); }
  .footer-note { margin: var(--space-7) 0 0; max-width: 36em; font-family: var(--font-display); font-style: italic; font-size: var(--text-lead); color: var(--text-muted); }
  @media (max-width: 1023px) {
    .head, .text { grid-column: 1 / -1; }
    .text { margin-top: var(--space-5); }
  }
</style>
