---
// Fieldnotes (specification §8), field-journal direction: published
// reflections (when there are any), the WordPress cards and feedback.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LovingCards from '../../components/fieldnotes/LovingCards.astro';
import FeedbackQuotes from '../../components/fieldnotes/FeedbackQuotes.astro';
import { href } from '../../data/navigation';
const notes = (await getCollection('fieldnotes', (n) => !n.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title="Fieldnotes" description="Reflections, feedback and notes from the Let's Talk About “Home” project.">
  <div class="journal">
    <header class="container container--wide intro">
      <h1>Fieldnotes</h1>
    </header>

    {notes.length > 0 && (
      <section class="container container--wide notes" aria-label="Reflections">
        <ul>
          {notes.map((n) => (
            <li>
              <a href={href(`fieldnotes/${n.id}/`)}>
                <span class="date hand">{fmt(n.data.date)}</span>
                <span class="title">{n.data.title}</span>
                {n.data.summary && <span class="summary">{n.data.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="container container--wide block"><LovingCards /></div>
    <div class="container container--wide block"><FeedbackQuotes /></div>
  </div>
</BaseLayout>

<style>
  .journal {
    background-color: var(--paper);
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, rgba(80, 58, 168, 0.07) 31px 32px);
    padding-bottom: var(--space-9);
  }
  .intro { padding-block: var(--space-9) var(--space-5); }
  .intro h1 { margin: 0; }
  .block { padding-top: var(--space-8); }
  .notes ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: var(--space-5); }
  .notes a { display: flex; flex-direction: column; gap: var(--space-2); height: 100%; padding: var(--space-5); background: var(--white); color: var(--ink); text-decoration: none; box-shadow: 0 2px 6px rgba(0,0,0,0.07); }
  .notes a:hover .title { text-decoration: underline; }
  .notes .date { color: var(--purple); font-size: 1.4rem; }
  .notes .title { font-family: var(--font-display); font-size: var(--text-h3); line-height: 1.2; }
  .notes .summary { color: var(--text-muted); font-size: var(--text-small); }
</style>
