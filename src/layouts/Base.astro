---
import '../styles/global.css';
import { SITE_TITLE, liveSections, url } from '../site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Conversations about place, belonging and identity.' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const sections = await liveSections();
const here = Astro.url.pathname;
const navSections = sections.filter((s) => s.collection !== 'dispatches');
const hasDispatches = sections.some((s) => s.collection === 'dispatches');
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="wide">
        <a class="site-title" href={url('/')}>{SITE_TITLE}</a>
        <nav class="site-nav" aria-label="Main">
          {navSections.map((s) => (
            <a href={url(`${s.path}/`)} aria-current={here.includes(`/${s.path}/`) ? 'page' : undefined}>{s.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wide">
        <span>{SITE_TITLE}</span>
        {hasDispatches && <a href={url('dispatches/')}>Dispatches</a>}
      </div>
    </footer>
  </body>
</html>
