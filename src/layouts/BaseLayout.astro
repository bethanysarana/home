---
import '../styles/global.css';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import ScrollToTop from '../components/interactions/ScrollToTop.astro';
import { SITE } from '../data/site';
import { href } from '../data/navigation';

interface Props {
  title?: string;
  description?: string;
  /** Keep development pages (e.g. the style guide) out of search engines. */
  noindex?: boolean;
}
const { title, description = SITE.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link-preview thumbnail (Bethany, 26 Nov 2026): the homepage hero photo, 1200×630.
const shareImage = new URL(href('images/share/share.jpg'), Astro.site);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('favicon/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('favicon/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('favicon/apple-touch-icon.png')} />
    <meta name="theme-color" content="#FFEE58" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A thatched wooden shelter looking out over bamboo huts and A-frame cabins, with a pot of tea on the table" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
  </body>
</html>
