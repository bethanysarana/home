---
// One fieldnote in the field-journal direction: layered images with captions
// and handwritten notes at the top, then the Markdown body (captioned figures
// and ✎ notes, see src/data/fieldnote-html.ts).
import type { CollectionEntry } from 'astro:content';
import { href } from '../../data/navigation';
import { fieldnoteHtml } from '../../data/fieldnote-html';
interface Props { entry: CollectionEntry<'fieldnotes'> }
const { entry } = Astro.props;
const body = fieldnoteHtml(entry.rendered?.html ?? '', import.meta.env.BASE_URL);
const d = entry.data;
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const src = (s: string) => (s.startsWith('/') ? href(s) : s);
---
<article class="journal">
  <header class="container head">
    <p class="crumbs"><a href={href('fieldnotes/')}>Fieldnotes</a></p>
    <p class="date hand"><time datetime={d.date.toISOString().slice(0, 10)}>{date}</time></p>
    <h1>{d.title}</h1>
    {d.summary && <p class="lead">{d.summary}</p>}
  </header>

  {d.layers.length > 0 && (
    <div class={`container spread n${d.layers.length}`}>
      {d.layers.map((l, i) => (
        <figure class={`layer l${i + 1}`}>
          <img src={src(l.src)} alt={l.alt} loading={i ? 'lazy' : 'eager'} />
          {l.caption && <figcaption>{l.caption}</figcaption>}
          {l.note && <p class="note hand">{l.note}</p>}
        </figure>
      ))}
    </div>
  )}

  <div class="container body">
    <Fragment set:html={body} />
  </div>
</article>

<style>
  .journal {
    background-color: var(--paper);
    background-image: repeating-linear-gradient(to bottom, transparent 0 31px, rgba(80, 58, 168, 0.07) 31px 32px);
    padding-bottom: var(--space-9);
  }
  .container { max-width: 46rem; }
  .head { padding-top: var(--space-8); }
  .crumbs { margin: 0 0 var(--space-4); font-size: var(--text-small); }
  .date { margin: 0; font-size: 1.6rem; color: var(--purple); transform: rotate(-1deg); display: inline-block; }
  h1 { margin: var(--space-2) 0 var(--space-4); }
  .lead { margin: 0; }

  .spread { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); margin-block: var(--space-8); }
  .layer { position: relative; align-self: start; margin: 0; background: var(--white); padding: 0.6rem 0.6rem 0.9rem; box-shadow: 0 3px 10px rgba(0,0,0,0.12); }
  .layer::before { content: ''; position: absolute; top: -9px; left: 50%; width: 4.5rem; height: 1.3rem; transform: translateX(-50%) rotate(-3deg); background: rgba(255, 238, 88, 0.6); z-index: 2; }
  .layer img { display: block; width: 100%; height: auto; }
  .layer figcaption { margin-top: 0.5rem; font-size: var(--text-caption); color: var(--text-muted); }
  .note { position: absolute; z-index: 3; margin: 0; max-width: 12rem; font-size: 1.5rem; line-height: 1.15; color: var(--purple); }
  .n1 .l1 { grid-column: 2 / span 10; transform: rotate(-1deg); }
  .n1 .l1 .note { right: -1rem; bottom: -2.5rem; transform: rotate(-3deg); }
  .n2 .l1 { grid-column: 1 / span 7; grid-row: 1; transform: rotate(-2deg); }
  .n2 .l2 { grid-column: 6 / span 7; grid-row: 1; margin-top: 30%; transform: rotate(2deg); z-index: 1; }
  .n3 .l1 { grid-column: 1 / span 6; grid-row: 1; transform: rotate(-2.5deg); }
  .n3 .l2 { grid-column: 5 / span 5; grid-row: 1; margin-top: 22%; transform: rotate(1.5deg); z-index: 1; }
  .n3 .l3 { grid-column: 8 / span 5; grid-row: 1; margin-top: 6%; transform: rotate(-1deg); }
  .spread .layer .note { left: 0.4rem; bottom: -2.6rem; transform: rotate(-2deg); }
  .spread .l2 .note, .spread .l3 .note { left: auto; right: 0.2rem; }
  .spread { padding-bottom: var(--space-7); }

  .body { font-size: var(--text-lead); line-height: 1.6; }
  .body :global(p) { margin: 0 0 var(--space-5); }
  .body :global(.fn-note) { font-family: var(--font-hand); font-size: 1.75rem; line-height: 1.2; color: var(--purple); transform: rotate(-1deg); margin: var(--space-6) 0 var(--space-6) var(--space-5); }
  .body :global(.fn-figure) { margin: var(--space-7) auto; max-width: 30rem; background: var(--white); padding: 0.6rem 0.6rem 0.9rem; box-shadow: 0 3px 10px rgba(0,0,0,0.1); transform: rotate(0.8deg); }
  .body :global(.fn-figure:nth-of-type(even)) { transform: rotate(-0.8deg); }
  .body :global(.fn-figure img) { display: block; width: 100%; height: auto; }
  .body :global(.fn-figure figcaption) { margin-top: 0.5rem; font-size: var(--text-caption); color: var(--text-muted); line-height: 1.4; }

  @media (max-width: 599px) {
    .spread { display: block; }
    .layer { margin-bottom: var(--space-8); }
    .n2 .l2, .n3 .l2, .n3 .l3 { margin-top: 0; }
    .n2 .l2, .n3 .l3 { margin-left: 18%; }
    .n3 .l2 { margin-right: 18%; }
  }
</style>
