---
// WordPress "What I'm loving so far!" cards (specification §8): the text is
// revealed on hover, focus or tap. Phones scroll the row sideways.
import W from '../../data/fieldnotes-wp.json';
const TONES = ['purple', 'pink', 'yellow', 'paper'];
---
<section class="loving" aria-labelledby="loving-h">
  <h2 id="loving-h" class="hand-heading">{W.lovingHeading}</h2>
  <ul class="cards" data-loving>
    {W.cards.map((c, i) => (
      <li class={`card tone-${TONES[i]}`}>
        <button type="button" aria-expanded="false" aria-controls={`love-${i}`}>
          <span class="title">{c.title}</span>
          <span class="plus" aria-hidden="true">+</span>
        </button>
        <p class="reveal" id={`love-${i}`}>{c.text}</p>
      </li>
    ))}
  </ul>
</section>

<script>
  document.querySelectorAll('[data-loving] button').forEach((b) =>
    b.addEventListener('click', () => b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'))));
</script>

<style>
  .hand-heading { font-family: var(--font-hand); font-weight: 500; font-size: clamp(2.2rem, 1.8rem + 2vw, 3.2rem); color: var(--purple); margin: 0 0 var(--space-5); transform: rotate(-1deg); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); }
  .card { position: relative; min-height: 15rem; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.08); overflow: hidden; }
  .card:nth-child(odd) { transform: rotate(-1.2deg); }
  .card:nth-child(even) { transform: rotate(1deg); }
  .card::before { content: ''; position: absolute; top: -6px; left: 50%; width: 4.5rem; height: 1.4rem; transform: translateX(-50%) rotate(-3deg); background: rgba(255, 238, 88, 0.55); z-index: 2; }
  .tone-purple { background: var(--purple-deep); color: var(--white); }
  .tone-pink { background: var(--pink); }
  .tone-yellow { background: var(--yellow); }
  .tone-yellow::before { background: rgba(246, 207, 244, 0.8); }
  .tone-paper { background: var(--white); }
  button { all: unset; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; width: 100%; min-height: 15rem; padding: var(--space-6) var(--space-5) var(--space-5); cursor: pointer; }
  button:focus-visible { outline: 3px solid var(--purple); outline-offset: -6px; }
  .title { font-family: var(--font-display); font-size: var(--text-h3); line-height: 1.15; }
  .plus { font-size: 1.5rem; line-height: 1; transition: transform 0.2s; }
  .reveal {
    position: absolute; inset: auto 0 0 0; margin: 0; padding: var(--space-5);
    font-family: var(--font-hand); font-size: 1.45rem; line-height: 1.2;
    background: inherit; opacity: 0; transform: translateY(0.75rem); transition: opacity 0.2s, transform 0.2s; pointer-events: none;
  }
  .card:has(button[aria-expanded='true']) .reveal, .card:focus-within .reveal { opacity: 1; transform: none; }
  .card:has(button[aria-expanded='true']) .plus { transform: rotate(45deg); }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .reveal { opacity: 1; transform: none; }
    .card:hover .plus { transform: rotate(45deg); }
  }
  @media (prefers-reduced-motion: reduce) { .reveal, .plus { transition: none; } }
  @media (max-width: 899px) {
    .cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: var(--space-4); padding: var(--space-3) var(--space-1) var(--space-4); margin-inline: calc(var(--space-1) * -1); }
    .card { flex: 0 0 72%; scroll-snap-align: start; }
  }
</style>
