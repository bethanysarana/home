---
import MainNavigation from './MainNavigation.astro';
import { href } from '../../data/navigation';
import { SITE } from '../../data/site';
---
<header class="site-header">
  <div class="container container--wide header-row">
    <p class="site-title"><a href={href('')}>{SITE.title}</a></p>
    <MainNavigation />
  </div>
</header>

<style>
  /* WordPress header: title left, menu right, padding-30 top and bottom */
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-30);
    padding-block: var(--space-30);
  }
  .site-title {
    margin: 0;
    font-size: var(--text-large);
    font-weight: 700;
    letter-spacing: -0.5px;
  }
  .site-title a { text-decoration: none; }
  .site-title a:hover { text-decoration: underline; }
</style>
