---
// Site header (design brief §5): handwritten project name on the left,
// restrained navigation and an understated call to explore on the right.
import MainNavigation from './MainNavigation.astro';
import { href } from '../../data/navigation';
---
<header class="site-header">
  <div class="container container--wide header-row">
    <a class="logo" href={href('')} aria-label="Let’s Talk About “Home” – home page">
      <span class="logo-line">Let’s Talk About</span>
      <span class="logo-line logo-home">“Home”</span>
    </a>
    <MainNavigation />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }
  .logo {
    display: flex;
    flex-direction: column;
    font-family: var(--font-hand);
    font-weight: 500;
    font-size: 1.45rem;
    line-height: 0.92;
    text-decoration: none;
    color: var(--ink);
  }
  .logo-home { padding-left: 0.55em; }
  .logo:hover { color: var(--purple); }
</style>
