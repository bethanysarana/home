---
import { liveNavigation, href } from '../../data/navigation';

const items = liveNavigation();
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\//, '');
const isCurrent = (path: string) => (path === '' ? current === '' : current.startsWith(path));
---
<nav class="main-nav" aria-label="Main">
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu">
    <span class="visually-hidden">Menu</span>
    <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h16v1.5H4zM4 15h16v1.5H4z" fill="currentColor" /></svg>
    <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="m13.06 12 6.47-6.47-1.06-1.06L12 10.94 5.53 4.47 4.47 5.53 10.94 12l-6.47 6.47 1.06 1.06L12 13.06l6.47 6.47 1.06-1.06L13.06 12Z" fill="currentColor" /></svg>
  </button>
  <ul id="main-menu" class="menu">
    {items.map((item) => (
      <li><a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .main-nav { font-size: var(--text-medium); }
  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-10) var(--space-30);
  }
  .menu a { text-decoration: none; }
  .menu a:hover, .menu a[aria-current='page'] { text-decoration: underline; }
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    margin: -8px;
    cursor: pointer;
  }
  .icon-close { display: none; }

  /* Collapsible menu on small screens (WordPress used an overlay at <600px) */
  @media (max-width: 781px) {
    .menu-toggle { display: inline-flex; position: relative; z-index: 101; }
    .menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 100;
      flex-direction: column;
      justify-content: flex-start;
      gap: var(--space-30);
      padding: calc(2rem + 64px) var(--page-padding) var(--page-padding);
      background: var(--colour-white);
      font-size: var(--text-x-large);
      animation: fadeIn var(--duration-fast) ease-out;
    }
    .main-nav.is-open .menu { display: flex; }
    .main-nav.is-open .icon-open { display: none; }
    .main-nav.is-open .icon-close { display: block; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.main-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
  const setOpen = (open: boolean) => {
    if (!nav || !toggle) return;
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(!nav?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  nav?.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
