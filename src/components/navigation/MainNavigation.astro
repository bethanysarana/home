---
import { liveNavigation, href } from '../../data/navigation';

const items = liveNavigation();
const sections = items.filter((i) => i.path !== '');
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\//, '');
const isCurrent = (path: string) => (path === '' ? current === '' : current.startsWith(path));
---
<nav class="main-nav" aria-label="Main">
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu">
    <span class="visually-hidden">Menu</span>
    <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h16v1.5H4zM4 15h16v1.5H4z" fill="currentColor" /></svg>
    <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="m13.06 12 6.47-6.47-1.06-1.06L12 10.94 5.53 4.47 4.47 5.53 10.94 12l-6.47 6.47 1.06 1.06L12 13.06l6.47 6.47 1.06-1.06L13.06 12Z" fill="currentColor" /></svg>
  </button>
  <div id="main-menu" class="menu">
    <ul class="menu-list">
      <li class="mobile-only"><a href={href('')} aria-current={isCurrent('') ? 'page' : undefined}>Home</a></li>
      {sections.map((item) => (
        <li><a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <a class="button cta" href={href('visual-archive/')}>Explore the project</a>
  </div>
</nav>

<style>
  .menu { display: flex; align-items: center; gap: var(--space-6); }
  .menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-5);
    font-size: var(--text-small);
    font-weight: 500;
  }
  .menu-list a { text-decoration: none; padding-block: 4px; border-bottom: 1px solid transparent; }
  .menu-list a:hover { color: var(--ink); border-bottom-color: var(--ink); }
  .menu-list a[aria-current='page'] { border-bottom-color: var(--purple); color: var(--purple); }
  .mobile-only { display: none; }

  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    margin: -8px;
    cursor: pointer;
    color: var(--ink);
  }
  .icon-close { display: none; }

  @media (max-width: 767px) {
    .menu-toggle { display: inline-flex; position: relative; z-index: 101; }
    .menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 100;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-7);
      padding: 96px var(--page-padding) var(--page-padding);
      background: var(--paper);
      animation: fadeIn var(--duration-fast) ease-out;
    }
    .menu-list { flex-direction: column; gap: var(--space-5); font-family: var(--font-display); font-size: var(--text-h2); font-weight: 400; }
    .mobile-only { display: list-item; }
    .main-nav.is-open .menu { display: flex; }
    .main-nav.is-open .icon-open { display: none; }
    .main-nav.is-open .icon-close { display: block; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.main-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
  const setOpen = (open: boolean) => {
    if (!nav || !toggle) return;
    nav.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(!nav?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  nav?.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
