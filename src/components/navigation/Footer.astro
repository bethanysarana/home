---
import { liveNavigation, href } from '../../data/navigation';
import { SITE } from '../../data/site';
const items = liveNavigation();
---
<footer class="site-footer">
  <div class="container container--wide footer-row">
    <p class="footer-title">{SITE.title}</p>
    <nav aria-label="Footer">
      <ul>
        {items.map((item) => <li><a href={href(item.path)}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>

<style>
  /* WordPress footer: site title left, vertical menu right */
  .site-footer {
    margin-top: var(--space-60);
    padding-block: var(--space-60) var(--space-70);
    border-top: 1px solid var(--colour-rule);
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-50);
  }
  .footer-title { font-weight: 700; letter-spacing: -0.5px; margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-10); font-size: var(--text-medium); }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
