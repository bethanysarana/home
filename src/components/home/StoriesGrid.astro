---
// "Explore the stories" (design brief §6): all eight findings in a grid of
// varied proportions.
// TEMPORARY: each story is a typographic block until Bethany's data art for
// the stories is ready (see MIGRATION_NOTES.md → Story visuals).
import { getCollection } from 'astro:content';
import { href } from '../../data/navigation';

const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
// Column spans on the 12-column grid, row by row: 7+5, 4+4+4, 5+7, 12.
const SPANS = [7, 5, 4, 4, 4, 5, 7, 12];
// Palette tones, arranged so neighbours never repeat.
const TONES = ['purple', 'pink', 'yellow', 'paper', 'purple', 'paper', 'yellow', 'pink'];
const items = stories.map((s, i) => ({ s, span: SPANS[i] ?? 4, tone: TONES[i] ?? 'paper' }));
---
<section class="stories section surface-white" aria-labelledby="stories-heading">
  <div class="container container--wide">
    <header class="section-intro grid-12">
      <div class="intro-head">
        <p class="eyebrow"><span class="num">01</span> The Stories</p>
        <h2 id="stories-heading">Explore the stories</h2>
      </div>
      <p class="intro-text lead">Eight traveller "stories" stand out. Each story is drawn from thematic analysis across every conversation to date.</p>
    </header>

    <ul class="grid">
      {items.map(({ s, span, tone }) => (
        <li class={`story span-${span} tone-${tone}`}>
          <a href={href(`stories/${s.id}/`)}>
            <p class="label">{s.data.label}</p>
            <h3 class="title">{s.data.headline}</h3>
            <p class="summary">{s.data.summary}</p>
            <span class="more">Read the story <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-intro { align-items: end; }
  .intro-head { grid-column: 1 / span 6; }
  .intro-head h2 { margin: 0; }
  .intro-text { grid-column: 8 / -1; margin: 0; color: var(--text-muted); }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .span-4 { grid-column: span 4; }
  .span-5 { grid-column: span 5; }
  .span-7 { grid-column: span 7; }
  .span-12 { grid-column: span 12; }

  .story a {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    min-height: 300px;
    padding: var(--space-6);
    border-radius: var(--radius-medium);
    text-decoration: none;
    color: var(--ink);
    transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }
  .story a:hover { transform: translateY(-3px); box-shadow: var(--shadow-card); }
  .span-7 a, .span-12 a { min-height: 360px; }

  .label { font-size: var(--text-caption); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 var(--space-3); }
  .title { font-size: var(--text-h3); margin: 0 0 var(--space-4); }
  .span-7 .title, .span-12 .title { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem); }
  .span-12 .title, .span-12 .summary { max-width: 30em; }
  .summary {
    margin: 0 0 var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .more { font-size: var(--text-small); font-weight: 600; text-decoration: underline; text-underline-offset: 0.3em; }

  /* Tones from the WordPress palette */
  .tone-purple a { background: var(--purple-deep); color: var(--white); }
  .tone-purple .label { color: var(--yellow); }
  .tone-purple .summary { color: rgba(255, 255, 255, 0.82); }
  .tone-pink a { background: var(--pink); }
  .tone-pink .label { color: var(--purple); }
  .tone-yellow a { background: var(--yellow); }
  .tone-yellow .label { color: var(--purple); }
  .tone-paper a { background: var(--paper); outline: 1px solid var(--rule-strong); outline-offset: -1px; }
  .tone-paper .label { color: var(--purple); }
  .tone-pink .summary, .tone-yellow .summary, .tone-paper .summary { color: #3B3B3B; }

  @media (max-width: 1023px) {
    .span-4, .span-5, .span-7 { grid-column: span 6; }
  }
  @media (max-width: 767px) {
    .intro-head, .intro-text { grid-column: 1 / -1; }
    .intro-text { margin-top: var(--space-4); }
    .grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .grid > li { grid-column: 1 / -1; }
    .story a, .span-7 a, .span-12 a { min-height: 0; padding: var(--space-5); }
  }
</style>
