---
// Quote carousel (Bethany, 26 Nov 2026): ten participants' words in the
// Karolina format (quote, name, story link, visual fingerprint).
// Quotes are copied exactly from Report 4 by scripts/make_quotes.py.
// Swipe or scroll sideways; previous/next buttons and arrow keys also work.
import { getCollection } from 'astro:content';
import QUOTES from '../../data/home-quotes.json';
import { PARTICIPANTS } from '../../data/participants';
import { href, isReady } from '../../data/navigation';

const stories = await getCollection('stories');
const slides = QUOTES.map((q) => {
  const p = PARTICIPANTS.find((x) => x.id === q.participant);
  const s = stories.find((x) => x.id === q.story);
  if (!p || !s) throw new Error(`Quote carousel: unknown participant or story for ${q.name}`);
  return { ...q, p, s, long: q.text.length > 110 };
});
---
<section class="quote-band surface-pink" aria-roledescription="carousel" aria-label="Participants' words" data-carousel>
  <div class="track" tabindex="0" aria-live="polite">
    {slides.map((q, i) => (
      <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
        <div class="container container--wide inner">
          <figure class="quote">
            <blockquote class={`pull-quote ${q.long ? 'long' : ''}`}><p>{q.text}</p></blockquote>
            <figcaption>
              <span class="who">{q.name}</span>
              {isReady('stories/') && <a class="arrow-link" href={href(`stories/${q.s.id}/`)} tabindex="-1" data-slide-link>{q.s.data.label} <span aria-hidden="true">→</span></a>}
            </figcaption>
          </figure>
          {q.p.artwork ? (
            <figure class="fingerprint img-frame">
              <img src={href(q.p.artwork)} alt={`${q.name}'s visual fingerprint${q.p.finalWord ? `: “${q.p.finalWord}”` : ''}`} width="900" height="900" loading={i === 0 ? 'eager' : 'lazy'} />
            </figure>
          ) : (
            <figure class="fingerprint pending" aria-label={`${q.name}'s artwork to come`}><span>Artwork to come</span></figure>
          )}
        </div>
      </div>
    ))}
  </div>
  <div class="container container--wide controls-row"><div class="controls">
    <button type="button" class="nav" data-prev aria-label="Previous quote">←</button>
    <p class="count" aria-hidden="true"><span data-current>1</span> / {slides.length}</p>
    <button type="button" class="nav" data-next aria-label="Next quote">→</button>
  </div></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const current = root.querySelector<HTMLElement>('[data-current]')!;
    const smooth = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(slides.length - 1, i)) * track.clientWidth, behavior: smooth() as ScrollBehavior });
    const update = () => {
      const i = index();
      current.textContent = String(i + 1);
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      slides.forEach((s, k) => {
        s.toggleAttribute('inert', k !== i);
        s.querySelectorAll('[data-slide-link]').forEach((a) => a.removeAttribute('tabindex'));
      });
    };
    prev.addEventListener('click', () => go(index() - 1));
    next.addEventListener('click', () => go(index() + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
    });
    let t: number | undefined;
    track.addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(update, 80); }, { passive: true });
    window.addEventListener('resize', () => go(index()));
    update();
  });
</script>

<style>
  .quote-band { padding-block: var(--space-9) var(--space-7); }
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 3px solid var(--purple); outline-offset: -3px; }
  .slide { flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; }
  .inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    align-items: center;
    min-height: 100%;
  }
  .quote { grid-column: 2 / span 7; margin: 0; }
  .quote p { margin: 0; }
  .quote blockquote { margin: 0; }
  .pull-quote.long { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem); line-height: 1.3; }
  figcaption { display: flex; flex-wrap: wrap; gap: var(--space-5); align-items: baseline; margin-top: var(--space-6); }
  .who { font-weight: 600; font-size: var(--text-small); letter-spacing: 0.06em; text-transform: uppercase; }
  .fingerprint {
    grid-column: 10 / span 3;
    margin: 0;
    transform: rotate(2deg);
    box-shadow: var(--shadow-card);
    background: var(--white);
    padding: 10px 10px 28px;
  }
  .fingerprint img { display: block; width: 100%; height: auto; }
  .pending { aspect-ratio: 1 / 1.08; display: grid; place-items: center; background: transparent; box-shadow: none; border: 1.5px dashed rgba(17, 17, 17, 0.35); }
  .pending span { font-size: var(--text-caption); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
  .controls-row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); margin-top: var(--space-6); }
  .controls { grid-column: 2 / -1; display: flex; align-items: center; gap: var(--space-4); }
  .nav { width: 3rem; height: 3rem; border-radius: 50%; border: 1.5px solid var(--ink); background: transparent; color: var(--ink); font-size: 1.25rem; cursor: pointer; }
  .nav:hover:not(:disabled) { background: var(--ink); color: var(--pink); }
  .nav:disabled { opacity: 0.3; cursor: default; }
  .nav:focus-visible { outline: 3px solid var(--purple); outline-offset: 2px; }
  .count { margin: 0; font-variant-numeric: tabular-nums; font-size: var(--text-small); font-weight: 600; letter-spacing: 0.08em; }
  @media (max-width: 767px) {
    .inner { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-7); }
    .fingerprint { width: 55%; align-self: flex-end; }
    .controls { grid-column: 1 / -1; }
  }
</style>
