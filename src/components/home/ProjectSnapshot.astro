---
// Project snapshot (specification §4, component 3), in the style of the
// WordPress "Travellers" card (#traveller-demo).
import { isReady, href } from '../../data/navigation';
import { TOTAL_PARTICIPANTS } from '../../data/participants';
const facts = [
  { big: String(TOTAL_PARTICIPANTS), text: 'conversations' },
  { text: 'Mobile volunteer community' },
  { text: 'Qualitative autobiographical narrative approach' },
  { text: 'Independent research project' },
];
---
<section class="container section" aria-labelledby="who-im-talking-to">
  <h2 id="who-im-talking-to" class="section-heading">Who I'm talking to</h2>
  <div class="outline-card">
    <h3 class="card-title">Travellers</h3>
    <p class="card-lines">
      Portable versions of home.<br />
      Temporary routines.<br />
      Familiarity built through movement.
    </p>
    <ul class="facts">
      {facts.map((f) => (
        <li>{f.big && <span class="fact-big">{f.big}</span>} <span>{f.text}</span></li>
      ))}
    </ul>
    {isReady('research/') && <p class="more"><a class="arrow-link" href={href('research/')}>The Research →</a></p>}
  </div>
</section>

<style>
  .card-title { margin: 0 0 8px; font-size: 1.3rem; font-weight: 600; color: var(--colour-charcoal); }
  .card-lines { margin: 0; font-size: var(--text-large); line-height: 1.55; color: #333; }
  .facts {
    list-style: none;
    margin: 24px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid #E5DED2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 24px;
    font-size: var(--text-medium);
    color: var(--colour-charcoal);
  }
  .facts li { line-height: 1.35; }
  .fact-big {
    display: block;
    font-size: var(--text-xx-large);
    font-weight: 600;
    color: var(--colour-terracotta);
    line-height: 1;
    margin-bottom: 4px;
  }
  .more { margin: 20px 0 0; }
  @media (max-width: 420px) { .facts { grid-template-columns: 1fr; } }
</style>
