---
// Rebuild of the WordPress cover block on the Home post:
// gradient linear-gradient(135deg, rgb(26,18,12) 38%, rgb(244,239,234) 100%)
// at 50% over the featured image, with the warm dark bottom gradient and
// rounded corners described in the post's custom CSS.
import { SITE } from '../../data/site';
import { href } from '../../data/navigation';
const image = SITE.heroImage;
---
<section class="hero-wrap container container--wide" aria-labelledby="hero-title">
  <div class={`hero ${image ? 'has-image' : ''}`}>
    {image && <img class="hero-image" src={href(image)} alt="" fetchpriority="high" />}
    <span class="hero-dim" aria-hidden="true"></span>
    <span class="hero-fade" aria-hidden="true"></span>
    <div class="hero-text">
      <h1 id="hero-title" class="hero-heading">Understanding place, belonging, and identity</h1>
      <p>As a Doctor of Applied Health Research and data scientist, my career has been built on translating complex patterns into human-centred solutions. After years of bridging clinical data and patient experiences in UK cancer services, I’ve developed a singular curiosity:</p>
      <p class="hero-question text-subtitle"><em><strong>How do we narrate our own lives?</strong></em></p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-large);
    min-height: clamp(420px, 70vh, 640px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--colour-white);
    background: linear-gradient(135deg, rgb(26, 18, 12) 38%, rgb(244, 239, 234) 100%);
  }
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* With an image: the WordPress gradient at 50% over it */
  .has-image .hero-dim {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgb(26, 18, 12) 38%, rgb(244, 239, 234) 100%);
    opacity: 0.5;
  }
  /* Without an image: a light warm dim keeps text contrast on the pale corner */
  .hero:not(.has-image) .hero-dim {
    position: absolute;
    inset: 0;
    background: rgba(20, 15, 12, 0.3);
  }
  /* Warm dark gradient concentrated towards the bottom */
  .hero-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    background: linear-gradient(to top, rgba(20, 15, 12, 0.75) 0%, rgba(20, 15, 12, 0.35) 60%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }
  .hero-text {
    position: relative;
    z-index: 2;
    width: 90%;
    max-width: 800px;
    text-align: center;
    padding-block: var(--space-60);
    text-shadow: 0 1px 3px rgba(20, 15, 12, 0.55), 0 0 18px rgba(20, 15, 12, 0.35);
  }
  .hero-text p { font-weight: 400; }
  .hero-heading {
    font-size: var(--text-x-large);
    margin-bottom: var(--space-30);
  }
  .hero-question { margin: var(--space-30) 0 0; }
</style>
