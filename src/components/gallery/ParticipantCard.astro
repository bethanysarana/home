---
// One canonical card per participant (design brief §7, specification §5.3).
// Front: visual fingerprint, name, final word, colour and shape, word category.
// Back:  full colour and shape, the three codes, and links to their stories.
// One flip state drives hover (mouse), tap and keyboard alike.
// Records without artwork show an obvious "to come" placeholder (brief §12).
import { getCollection } from 'astro:content';
import type { Participant } from '../../data/participants';
import { TIER1, TIER2, labelFor } from '../../data/gallery-filters';
import { href, isReady } from '../../data/navigation';
import { storiesFor } from '../../data/relationships';

interface Props {
  participant: Participant;
  /** Optional small tag under the card, e.g. "Complicates" on story pages. */
  tag?: string;
}
const { participant: p, tag } = Astro.props;
const NOT_CODED = 'Not yet coded';
const category = labelFor(TIER1.options, p.finalWordCategory);
const codes = [
  { term: TIER1.heading, value: category },
  { term: TIER2.lenses.findcreate.label, value: labelFor(TIER2.lenses.findcreate.options, p.findCreate) },
  {
    term: TIER2.lenses.placefeeling.label,
    value: labelFor(TIER2.lenses.placefeeling.options, p.placeFeeling),
    interpretation: p.placeFeelingIsInterpretation,
  },
];
const word = p.finalWord ? `“${p.finalWord}”` : null;
const stories = isReady('stories/')
  ? (await getCollection('stories'))
      .filter((s) => storiesFor(p.id).includes(s.id))
      .sort((a, b) => a.data.order - b.data.order)
  : [];
const backId = `card-back-${p.id}`;
const pending = !p.artwork;
---
<li
  class={`card ${pending ? 'is-pending' : ''}`}
  data-card
  data-participant={p.id}
  data-finalwordcategory={p.finalWordCategory ?? ''}
  data-findcreate={p.findCreate ?? ''}
  data-placefeeling={p.placeFeeling ?? ''}
  data-placefeeling-source={p.placeFeelingIsInterpretation ? 'inferred' : undefined}
>
  <div class="card-inner" data-flipped="false">
    <div class="face front">
      <button class="flip-btn" type="button" aria-expanded="false" aria-controls={backId}>
        <span class="art">
          {p.artwork
            ? <img src={href(p.artwork)} alt={`${p.displayName}'s visual fingerprint`} width="900" height="900" loading="lazy" />
            : <span class="art-missing">Artwork to come</span>}
          <span class="name">{p.displayName}</span>
        </span>
        <span class="info">
          <span class={`word ${word ? '' : 'word-missing'}`}>{word ?? 'Final word to come'}</span>
          {(p.colour || p.shape) && (
            <span class="meta">
              {p.colour && <span><span class="meta-term">Colour</span> {p.colour}</span>}
              {p.shape && <span><span class="meta-term">Shape</span> {p.shape}</span>}
            </span>
          )}
          {category && <span class="chip">{category}</span>}
        </span>
        <span class="visually-hidden"> – show more about {p.displayName}'s answer</span>
      </button>
    </div>

    <div class="face back" id={backId} inert>
      <button class="unflip-btn" type="button" aria-label={`Back to ${p.displayName}'s fingerprint`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
      </button>
      <p class="back-name">{p.displayName}</p>
      {word && <p class="back-word">{word}</p>}
      <dl class="rows">
        {p.colour && <div class="row"><dt>Colour</dt><dd>{p.colour}</dd></div>}
        {p.shape && <div class="row"><dt>Shape</dt><dd>{p.shape}</dd></div>}
        {p.artNote && <div class="row"><dt class="visually-hidden">Note</dt><dd class="note">{p.artNote}</dd></div>}
        {codes.map((r) => (
          <div class="row">
            <dt>{r.term}</dt>
            <dd class={r.value ? '' : 'uncoded'}>
              {r.value ?? NOT_CODED}
              {r.interpretation && <span class="read-tag">researcher's read</span>}
            </dd>
          </div>
        ))}
      </dl>
      {p.biographyApproved && p.biography && <p class="bio">{p.biography}</p>}
      {stories.length > 0 && (
        <div class="card-stories">
          <p class="stories-term">The Stories</p>
          <ul>{stories.map((s) => <li><a href={href(`stories/${s.id}/`)}>{s.data.label}</a></li>)}</ul>
        </div>
      )}
    </div>
  </div>
  {tag && <span class="card-tag">{tag}</span>}
</li>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    list-style: none;
    border-radius: var(--radius-large);
    transition: opacity var(--duration-fast) var(--ease);
  }
  .card[hidden] { display: none; }
  .card-inner {
    position: relative;
    display: grid;
    flex: 1;
    width: 100%;
    perspective: 2000px;
  }
  .face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.5s var(--ease), opacity 0.2s ease, box-shadow var(--duration) var(--ease);
  }
  .card:hover .face { box-shadow: 0 2px 4px rgba(17, 17, 17, 0.06), 0 18px 36px -16px rgba(17, 17, 17, 0.28); }

  /* Front */
  .flip-btn {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    color: var(--ink);
  }
  .art { position: relative; display: block; aspect-ratio: 1 / 1; background: var(--paper); overflow: hidden; }
  .art img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .card:hover .art img { transform: scale(1.03); }
  .name {
    position: absolute;
    left: 10px;
    top: 10px;
    font-family: var(--font-hand);
    font-size: 1.45rem;
    line-height: 1;
    padding: 3px 10px 5px;
    background: rgba(255, 255, 255, 0.92);
    border-radius: var(--radius-small);
  }
  .info { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-4); flex: 1; }
  .word { font-family: var(--font-display); font-style: italic; font-size: 1.3rem; line-height: 1.25; }
  .meta {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--text-caption);
    line-height: 1.45;
    color: var(--text-muted);
  }
  .meta > span + span::before { content: ' · '; }
  .meta-term { font-weight: 600; color: var(--ink); }
  .info .chip { align-self: flex-start; margin-top: auto; }

  /* Placeholder for records awaiting artwork */
  .art-missing {
    position: absolute;
    inset: 10px;
    display: grid;
    place-items: center;
    border: 1.5px dashed var(--rule-strong);
    border-radius: var(--radius-medium);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
    padding: var(--space-3);
  }
  @media (max-width: 560px) { .art-missing { font-size: 0.7rem; inset: 6px; } }
  .word-missing { font-family: var(--font-sans); font-style: normal; font-size: var(--text-small); color: var(--text-muted); }

  /* Back */
  .back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
    gap: var(--space-3);
    padding: var(--space-5) var(--space-4) var(--space-4);
    background: var(--paper);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .back.has-more { -webkit-mask-image: linear-gradient(to bottom, #000 85%, transparent); mask-image: linear-gradient(to bottom, #000 85%, transparent); }
  .unflip-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
  }
  .unflip-btn:hover { background: var(--ink); color: var(--white); }
  .back-name { margin: 0; font-family: var(--font-hand); font-size: 1.6rem; line-height: 1; padding-right: 40px; }
  .back-word { margin: 0; font-family: var(--font-display); font-style: italic; font-size: 1.25rem; line-height: 1.25; }
  .rows { margin: 0; display: grid; gap: var(--space-2); }
  .row dt, .stories-term {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--purple);
  }
  .row dd { margin: 1px 0 0; font-size: var(--text-small); line-height: 1.45; }
  .row dd.note { font-family: var(--font-display); font-style: italic; color: var(--text-muted); }
  .row dd.uncoded { color: var(--text-muted); font-style: italic; }
  .read-tag {
    display: inline-block;
    margin-left: 6px;
    padding: 0 8px;
    font-size: 0.68rem;
    font-style: normal;
    border: 1px dashed var(--purple);
    border-radius: var(--radius-pill);
    color: var(--purple);
    vertical-align: 1px;
  }
  .bio { margin: 0; font-size: var(--text-small); line-height: 1.5; }
  .card-stories ul { list-style: none; margin: 2px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2px 12px; }
  .card-stories a { font-size: var(--text-small); font-weight: 600; color: var(--purple); }

  .card-inner[data-flipped='true'] .front { transform: rotateY(-180deg); }
  .card-inner[data-flipped='true'] .back { transform: rotateY(0deg); }

  @media (prefers-reduced-motion: reduce) {
    .face { transform: none !important; }
    .back { opacity: 0; }
    .card-inner[data-flipped='true'] .front { opacity: 0; }
    .card-inner[data-flipped='true'] .back { opacity: 1; }
  }

  /* Dashed border where a tag is the researcher's interpretive read */
  .card.provenance-inferred .face { border: 1.5px dashed var(--purple); }
  .card.provenance-inferred::after {
    content: "researcher's read";
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    background: var(--purple);
    color: var(--white);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    pointer-events: none;
  }

  .card-tag {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--purple);
  }

  @media (max-width: 560px) {
    .name { font-size: 1.15rem; left: 6px; top: 6px; padding: 2px 7px 4px; }
    .info { padding: var(--space-3); }
    .word { font-size: 1.05rem; }
    .meta { -webkit-line-clamp: 3; font-size: 0.75rem; }
    .back { padding: var(--space-4) var(--space-3) var(--space-3); gap: var(--space-2); }
    .back-name { font-size: 1.3rem; }
    .back-word { font-size: 1.05rem; }
    .row dd { font-size: 0.8rem; }
  }
</style>

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
    const inner = card.querySelector<HTMLElement>('.card-inner')!;
    const flipBtn = card.querySelector<HTMLButtonElement>('.flip-btn')!;
    const unflipBtn = card.querySelector<HTMLButtonElement>('.unflip-btn')!;
    const front = card.querySelector<HTMLElement>('.front')!;
    const back = card.querySelector<HTMLElement>('.back')!;
    let pinned = false; // flipped by tap, click or keyboard rather than hover

    const updateFade = () => back.classList.toggle('has-more', back.scrollHeight - back.scrollTop - back.clientHeight > 4);
    back.addEventListener('scroll', updateFade, { passive: true });

    const set = (flipped: boolean, moveFocus = false) => {
      inner.dataset.flipped = String(flipped);
      flipBtn.setAttribute('aria-expanded', String(flipped));
      back.inert = !flipped;
      front.inert = flipped;
      if (flipped) { back.scrollTop = 0; updateFade(); }
      if (moveFocus) (flipped ? unflipBtn : flipBtn).focus({ preventScroll: true });
    };

    flipBtn.addEventListener('click', () => { pinned = true; set(true, true); });
    unflipBtn.addEventListener('click', () => { pinned = false; set(false, true); });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && inner.dataset.flipped === 'true') { pinned = false; set(false, true); }
    });
    card.addEventListener('mouseenter', () => { if (finePointer.matches && !pinned) set(true); });
    card.addEventListener('mouseleave', () => { if (finePointer.matches && !pinned) set(false); });
  });
</script>
