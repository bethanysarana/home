---
// The two-layer gallery (WordPress #theme-gallery), with both layers combined.
import ParticipantCard from './ParticipantCard.astro';
import { publishedParticipants } from '../../data/participants';
import { TIER1, TIER2 } from '../../data/gallery-filters';

const people = publishedParticipants();
const lenses = Object.entries(TIER2.lenses) as [keyof typeof TIER2.lenses, (typeof TIER2.lenses)[keyof typeof TIER2.lenses]][];
---
<section class="gallery container container--wide" aria-labelledby="sort-heading" data-gallery>
  <div class="controls">
    <h2 id="sort-heading" class="sort-heading">Try sorting the gallery by how each person described home</h2>

    <div class="tier">
      <h3 class="tier-heading" id="tier1-heading">{TIER1.heading}</h3>
      <p class="tier-caption">{TIER1.caption}</p>
      <div class="pill-row" role="group" aria-labelledby="tier1-heading">
        {TIER1.options.map(([value, label], i) => (
          <button type="button" class="pill" data-tier1={value} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
        ))}
      </div>
    </div>

    <div class="tier">
      <h3 class="tier-heading" id="tier2-heading">{TIER2.heading}</h3>
      <p class="tier-caption">{TIER2.caption}</p>
      <div class="pill-row lens-row" role="group" aria-label="Lens">
        {lenses.map(([key, lens], i) => (
          <button type="button" class="pill" data-lens={key} aria-pressed={i === 0 ? 'true' : 'false'}>{lens.label}</button>
        ))}
      </div>
      {lenses.map(([key, lens], i) => (
        <div class="lens-panel" data-lens-panel={key} hidden={i !== 0}>
          <p class="lens-explainer">{lens.explainer}</p>
          <div class="pill-row" role="group" aria-label={lens.label}>
            {lens.options.map(([value, label], j) => (
              <button type="button" class="pill" data-tier2={value} aria-pressed={j === 0 ? 'true' : 'false'}>{label}</button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="filter-count" aria-live="polite" data-count>{people.length} of {people.length} shown</p>
  </div>

  <ul class="grid" data-grid>
    {people.map((p) => <ParticipantCard participant={p} />)}
  </ul>

  <div class="container after">
    <p class="text-small">*images co-created with a $2 watercolour set and AI</p>
    <p>Stay tuned to see how I continue to curate and group these into the evolving themes of the project!</p>
  </div>
</section>

<style>
  .controls { max-width: var(--content-width); margin: 0 auto; }
  .sort-heading { font-size: var(--text-large); padding-block: var(--space-20); margin-top: var(--space-40); }
  .tier { margin-bottom: 18px; }
  .tier-heading { margin: 0 0 2px; font-size: 1rem; font-weight: 600; color: var(--colour-charcoal); }
  .tier-caption { margin: 0 0 10px; font-size: 0.8rem; color: var(--colour-muted); font-style: italic; }
  .lens-row { margin-bottom: 10px; }
  .lens-explainer { font-size: 0.8rem; color: #666; margin: 0 0 10px; font-style: italic; }
  .filter-count { font-size: 0.85rem; color: var(--colour-muted); margin: 4px 0 20px; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 16px;
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
  .after { margin-top: var(--space-40); padding-inline: 0; max-width: var(--content-width); }
</style>

<script>
  import { applyFilters, countText, type FilterState, type Lens } from './GalleryFilters';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-grid] > li'));
    const codes = cards.map((c) => ({
      finalWordCategory: c.dataset.finalwordcategory ?? '',
      findCreate: c.dataset.findcreate ?? '',
      placeFeeling: c.dataset.placefeeling ?? '',
    }));
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const state: FilterState = { tier1: 'all', lens: 'findcreate', tier2: 'all' };

    const press = (buttons: NodeListOf<HTMLButtonElement> | HTMLButtonElement[], active: (b: HTMLButtonElement) => boolean) =>
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(active(b))));

    const render = () => {
      const r = applyFilters(codes, state);
      cards.forEach((card, i) => {
        card.hidden = !r.visible[i];
        card.classList.toggle('provenance-inferred', state.lens === 'placefeeling' && card.dataset.placefeelingSource === 'inferred');
      });
      countEl.textContent = countText(r, state);
      press(root.querySelectorAll('[data-tier1]'), (b) => b.dataset.tier1 === state.tier1);
      press(root.querySelectorAll('[data-lens]'), (b) => b.dataset.lens === state.lens);
      root.querySelectorAll<HTMLElement>('[data-lens-panel]').forEach((p) => {
        p.hidden = p.dataset.lensPanel !== state.lens;
        press(p.querySelectorAll('[data-tier2]'), (b) => p.dataset.lensPanel === state.lens && b.dataset.tier2 === state.tier2);
      });
    };

    root.querySelectorAll<HTMLButtonElement>('[data-tier1]').forEach((b) =>
      b.addEventListener('click', () => { state.tier1 = b.dataset.tier1!; render(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-lens]').forEach((b) =>
      b.addEventListener('click', () => { state.lens = b.dataset.lens as Lens; state.tier2 = 'all'; render(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-tier2]').forEach((b) =>
      b.addEventListener('click', () => { state.tier2 = b.dataset.tier2!; render(); }));

    render();
  });
</script>
